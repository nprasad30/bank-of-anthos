<mxfile host="drawio">
  <diagram id="payment-flow" name="Payment flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="How a payment reaches the ledger" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;fill in the payment form" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;turns dollars into cents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ledgerwriter" value="&lt;b&gt;Ledgerwriter&lt;/b&gt;&lt;br&gt;checks the payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ledgerdb" value="&lt;b&gt;Ledger database&lt;/b&gt;&lt;br&gt;records the payment" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="95" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#374151;strokeWidth=2;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#374151;strokeWidth=2;" edge="1" parent="1" source="frontend" target="ledgerwriter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="if every check passes" style="endArrow=block;endFill=1;html=1;strokeColor=#374151;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="ledgerwriter" target="ledgerdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="balancereader" value="&lt;b&gt;Balancereader&lt;/b&gt;&lt;br&gt;reports your balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="260" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="enough money?" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#6B7280;dashed=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ledgerwriter" target="balancereader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rules" value="&lt;b&gt;Rules ledgerwriter checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. You are logged in&lt;br&gt;2. Not a repeat of the same payment&lt;br&gt;3. Account = 10 digits, routing = 9 digits&lt;br&gt;4. You are sending from your own account&lt;br&gt;5. Not sending to yourself&lt;br&gt;6. Amount is more than zero&lt;br&gt;7. You have enough money" style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=none;html=1;dashed=1;strokeColor=#D97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="ledgerwriter" target="rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
